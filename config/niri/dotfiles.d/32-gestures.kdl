// SPDX-License-Identifier: MIT
gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }

    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }

    // Hot corners off (use the overview bind instead).
    hot-corners {
        off
    }
}
