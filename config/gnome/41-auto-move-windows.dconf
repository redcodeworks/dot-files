# Auto Move Windows: which app opens on which workspace (2 = browsers, 3 = media and messages, 4 = games). These are the owner's app ids, and loading REPLACES your list: edit it first.
# Load:   dconf load /org/gnome/shell/extensions/auto-move-windows/ < 41-auto-move-windows.dconf
# Undo:   dconf reset -f /org/gnome/shell/extensions/auto-move-windows/
[/]
application-list=['org.mozilla.firefox.desktop:2', 'org.chromium.Chromium.desktop:2', 'io.gitlab.news_flash.NewsFlash.desktop:2', 'org.gnome.Showtime.desktop:3', 'org.gnome.Decibels.desktop:3', 'sh.cider.Cider.desktop:3', 'org.gnome.Podcasts.desktop:3', 'org.telegram.desktop.desktop:3', 'so.libdb.dissent.desktop:3', 'org.mozilla.thunderbird.desktop:3', 'org.gnome.Contacts.desktop:3', 'org.gnome.Music.desktop:3', 'io.mpv.Mpv.desktop:3', 'com.plexamp.Plexamp.desktop:3', 'tv.plex.PlexDesktop.desktop:3', 'com.slack.Slack.desktop:3', 'com.valvesoftware.Steam.desktop:4', 'steam-gamescope.desktop:4', 'net.lutris.Lutris.desktop:4', 'com.usebottles.bottles.desktop:4', 'bottles-Vortex-Vortex.desktop:4', 'net.davidotek.pupgui2.desktop:4', 'dev.lizardbyte.app.Sunshine.desktop:4', 'org.libretro.RetroArch.desktop:4', 'esde.desktop:4', 'duckstation.desktop:4', 'net.pcsx2.PCSX2.desktop:4', 'net.rpcs3.RPCS3.desktop:4', 'net.shadps4.shadPS4.desktop:4', 'yuzu.desktop:4', 'org.mamedev.MAME.desktop:4', 'org.jellyfin.JellyfinDesktop.desktop:3', 'org.gnome.Epiphany.desktop:2', 'org.kde.kasts.desktop:3']
