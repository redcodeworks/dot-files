{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Use with: fastfetch --config ~/.config/fastfetch/dotfiles.jsonc
    // "type": "small" (no "source") auto-detects the OS *and* picks its
    // small builtin variant natively -- no per-distro name mapping needed.
    // Useful when the same config is shared into containers (e.g. distrobox)
    // that run a different distro, where a fixed logo would be wrong.
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "command",
            "key": " ",
            // distrobox bind-mounts the host's /etc/hostname read-only into
            // its containers, so `hostname` always reports the host name
            // even inside a container -- CONTAINER_ID (set by
            // distrobox-enter to the container's name) is what actually
            // tells us where we are.
            "text": "printf '%s@%s' \"$USER\" \"${CONTAINER_ID:-$(hostname)}\"",
            "format": "{result}"
        },
        // {pretty-name} is /etc/os-release PRETTY_NAME (e.g. "Fedora Linux 45
        // (Silverblue)"): works on any distro and drops the trailing architecture the
        // default format adds (the line was wrapping in narrow terminals).
        { "type": "os", "format": "{pretty-name}" },
        "kernel",
        "shell",
        // One total instead of the per-manager list (was ~120 columns and
        // wrapped). {all} counts whichever managers exist in each environment, so it
        // stays correct inside containers too (a fixed {rpm} showed 0 in a non-rpm container).
        { "type": "packages", "format": "{all}" },
        "memory",
        "uptime"
    ]
}
