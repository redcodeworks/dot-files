# dot-files .gitignore: ALLOW-LIST FIRST. Everything is ignored unless it is listed here, so a stray file in the
# repo root (a backup, a key, a scratch note) can never be committed by accident. Then a DENY-LIST applies inside
# the allowed trees as a second line of defence: add anything private you can think of, never remove entries.

/*
!/.gitignore
!/.github
!/githooks
!/tools
!/config
!/justfile
!/Brewfile
!/README.md
!/AGENTS.md
!/LICENSE
!/LICENSES
!/NOTICE

# ---- deny-list (applies inside config/, tools/, .github/ ...) ------------------------------------------------------
# keys, certificates, tokens, credentials
*.key
*.pem
*.p12
*.pfx
*.p8
*.pub.bak
*.crt
*.cer
*.csr
*.der
*.jks
*.keystore
*.asc
*.gpg
*.pgp
*.kdbx
*.kdb
*.age
*.sops.*
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
*.token
*.tokens
*token*
*secret*
*credential*
*passwd*
*password*
*.htpasswd
.netrc
_netrc
.npmrc
.pypirc
.git-credentials
.pgpass
.my.cnf
.s3cfg
.boto
auth.json
auth.toml
oauth*
**/hosts.yml
**/.docker/config.json
**/gh/hosts.yml
**/rclone.conf
**/borg/
**/vorta/
**/restic*/
**/tailscale/
**/wireguard/
**/openvpn/
**/NetworkManager/system-connections/
**/*.ovpn
**/*.wg
**/known_hosts*
**/authorized_keys*
**/u2f_keys
**/Yubico/
**/.ssh/
**/ssh/
**/.gnupg/
**/gnupg/
**/keyrings/
**/kwalletd/
**/kdeconnect/
**/goa-1.0/
**/evolution/
**/aws/
**/gcloud/
**/azure/
**/kube/
**/op/
**/1Password/
**/Bitwarden/
**/keepassxc/
**/pass/
**/.password-store/

# environment and local-only config
.env
.env.*
*.env
!.env.example
*.local
*.local.*
local.*
local-*
.leak-patterns
leak-patterns

# application state, history, databases, caches, logs
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.sql
*.dump
*history*
.*_history
*.log
*.log.*
*.cache
cache/
Cache/
.cache/
__pycache__/
*.py[cod]
node_modules/
.venv/
venv/
*.lock
*.pid
*.sock
*.socket
state/
.local/
recently-used*
*.recent
*session*
*.bak
*.bak.*
*.orig
*.rej
*.tmp
*.temp
*.swp
*.swo
*~
core
core.*
*.core
*.dmp

# browsers, chat clients, mail, sync clients, IDEs (profiles hold personal data)
**/chromium/
**/google-chrome*/
**/BraveSoftware/
**/mozilla/
**/thunderbird/
**/discord/
**/vesktop/
**/Slack/
**/Signal/
**/Telegram*/
**/Nextcloud/
**/syncthing/
**/obsidian/
**/Code/
**/Code - OSS/
**/JetBrains/
**/zoom*
**/Postman/
**/dconf/user

# media and documents
*.iso
*.img
