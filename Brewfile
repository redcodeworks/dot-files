# Command-line tools the configs in config/ use or call. Install with: just brew   (dry run: just brew --dry-run)
# Homebrew formulae only: no casks (they do not exist on Linux) and no taps. Language toolchains and language servers
# are deliberately not listed. Every tool is optional: a config whose tool is missing simply does less.

# config/fish/conf.d/50-dotfiles-interactive.fish (fp alias preview), config/helix/rg-fzf.sh (preview)
brew "bat"
# config/niri/dotfiles.d/42-binds-apps.kdl (system monitor bind), config/btop (theme)
brew "btop"
# config/fish/conf.d/50-dotfiles-interactive.fish, config/eza/theme.yml (theme), config/yazi/yazi.toml (previewer)
brew "eza"
# config/fish/functions/fish_greeting.fish, config/fastfetch/dotfiles.jsonc
brew "fastfetch"
# config/fish/conf.d/60-dotfiles-fzf-colors.fish (colours), config/fish/conf.d/50-dotfiles-interactive.fish, config/helix/rg-fzf.sh
brew "fzf"
# tools/leak-check.sh and the CI secret scan (used when installed)
brew "gitleaks"
# config/yazi/yazi.toml (markdown previewer)
brew "glow"
# config/helix (the `hx` editor), config/fish/conf.d/20-dotfiles-editor.fish (EDITOR), config/zellij layout
brew "helix"
# config/lazygit/dotfiles-gruvbox-material.yml, config/helix/config.toml (C-g binding)
brew "lazygit"
# config/yazi/yazi.toml and keymap.toml (archive preview and extraction)
brew "ouch"
# config/helix/rg-fzf.sh and config/helix/config.toml (C-f live search)
brew "ripgrep"
# config/helix/languages.toml (TOML formatter)
brew "taplo"
# config/yazi, config/fish/functions/y.fish, config/helix/config.toml (C-y file chooser), config/zellij/layouts/dotfiles-yazelix.kdl
brew "yazi"
# config/zellij (theme and layout), config/niri/dotfiles.d/42-binds-apps.kdl and 51-workspace-routing.kdl
brew "zellij"
